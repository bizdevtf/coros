{
  "name": "coros-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that connects COROS Training Hub data (activities, heart rate, training load) for AI analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "coros-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
